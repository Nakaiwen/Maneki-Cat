{
  "title": "雷雨師一百籤／關聖帝君靈籤",
  "version": "0.2",
  "retrievedAt": "2026-10-04",
  "sourceIndex": "https://zh.wikisource.org/wiki/關聖帝君靈籤",
  "editorialNote": "本資料依維基文庫各籤頁轉錄四句原文與籤等，保留所列來源異文，沒有混用其他網站的字句。第69籤的行內註釋「樽指酒杯」未計入籤詩。尚未逐字對照古籍掃描本。",
  "fortunes": [
    {
      "id": 1,
      "grade": "大吉",
      "lines": [
        "巍巍獨步向雲間",
        "玉殿千官第一班",
        "富貴榮華天付汝",
        "福如東海壽如山"
      ],
      "sourceUrl": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/1",
      "sourceName": "維基文庫《關聖帝君靈籤》",
      "sourceHeading": "第一籤　甲甲　大吉"
    },
    {
      "id": 2,
      "grade": "上吉",
      "lines": [
        "盈虛消息總天時",
        "自此君當百事宜",
        "若問前程歸縮地",
        "更須方寸好修為"
      ],
      "sourceUrl": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/2",
      "sourceName": "維基文庫《關聖帝君靈籤》",
      "sourceHeading": "第二籤　甲乙　上吉"
    },
    {
      "id": 3,
      "grade": "中吉",
      "lines": [
        "衣食自然生處有",
        "勸君不用苦勞心",
        "但能孝悌存忠信",
        "福祿來成禍不侵"
      ],
      "sourceUrl": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/3",
      "sourceName": "維基文庫《關聖帝君靈籤》",
      "sourceHeading": "第三籤　甲丙　中吉"
    },
    {
      "id": 4,
      "grade": "下吉",
      "lines": [
        "去年百事頗相宜",
        "若較今年時運衰",
        "好把瓣香告神佛",
        "莫教福謝悔無追"
      ],
      "sourceUrl": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/4",
      "sourceName": "維基文庫《關聖帝君靈籤》",
      "sourceHeading": "第四籤　甲丁　下吉"
    },
    {
      "id": 5,
      "grade": "中平",
      "lines": [
        "子有三般不自由",
        "門庭蕭索冷如秋",
        "若逢牛鼠交承日",
        "萬事回春不用憂"
      ],
      "sourceUrl": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/5",
      "sourceName": "維基文庫《關聖帝君靈籤》",
      "sourceHeading": "第五籤　甲戊　中平"
    },
    {
      "id": 6,
      "grade": "下平",
      "lines": [
        "何勞鼓瑟更吹笙",
        "寸步如登萬里程",
        "彼此懷疑不相信",
        "休將私意憶濃情"
      ],
      "sourceUrl": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/6",
      "sourceName": "維基文庫《關聖帝君靈籤》",
      "sourceHeading": "第六籤　甲己　下平"
    },
    {
      "id": 7,
      "grade": "大吉",
      "lines": [
        "仙風道骨本天生",
        "又遇仙宗為主盟",
        "指日丹成謝巖谷",
        "一朝引領向天行"
      ],
      "sourceUrl": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/7",
      "sourceName": "維基文庫《關聖帝君靈籤》",
      "sourceHeading": "第七籤　甲庚　大吉"
    },
    {
      "id": 8,
      "grade": "上上",
      "lines": [
        "年來耕稼苦無收",
        "今歲田疇定有秋",
        "況遇太平無事日",
        "士農工賈百無憂"
      ],
      "sourceUrl": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/8",
      "sourceName": "維基文庫《關聖帝君靈籤》",
      "sourceHeading": "第八籤　甲辛　上上"
    },
    {
      "id": 9,
      "grade": "大吉",
      "lines": [
        "望渠消息向長安",
        "常把菱花仔細看",
        "見說文書將入境",
        "今朝喜色上眉端"
      ],
      "sourceUrl": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/9",
      "sourceName": "維基文庫《關聖帝君靈籤》",
      "sourceHeading": "第九籤　甲壬　大吉"
    },
    {
      "id": 10,
      "grade": "下吉",
      "lines": [
        "病患時時命蹇衰",
        "何須打瓦共鑽龜",
        "宜教重見一陽復",
        "始可求神仗佛持"
      ],
      "sourceUrl": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/10",
      "sourceName": "維基文庫《關聖帝君靈籤》",
      "sourceHeading": "第十籤　甲癸　下吉"
    },
    {
      "id": 11,
      "grade": "下下",
      "lines": [
        "今年好事一番新",
        "富貴榮華萃汝身",
        "誰道機關難料處",
        "到頭獨立轉傷神"
      ],
      "sourceUrl": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/11",
      "sourceName": "維基文庫《關聖帝君靈籤》",
      "sourceHeading": "第11簽 下下"
    },
    {
      "id": 12,
      "grade": "中平",
      "lines": [
        "營為期望在春前",
        "誰料秋來又不然",
        "直遇清江貴公子",
        "一生活計始安全"
      ],
      "sourceUrl": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/12",
      "sourceName": "維基文庫《關聖帝君靈籤》",
      "sourceHeading": "第12簽 中平"
    },
    {
      "id": 13,
      "grade": "中平",
      "lines": [
        "君今庚甲未亨通",
        "且向江頭作釣翁",
        "玉兔重生應發跡",
        "萬人頭上逞英雄"
      ],
      "sourceUrl": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/13",
      "sourceName": "維基文庫《關聖帝君靈籤》",
      "sourceHeading": "第13簽 中平"
    },
    {
      "id": 14,
      "grade": "下下",
      "lines": [
        "一見佳人便喜歡",
        "誰知去後有多般",
        "人情冷暖君休訝",
        "歷涉應知行路難"
      ],
      "sourceUrl": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/14",
      "sourceName": "維基文庫《關聖帝君靈籤》",
      "sourceHeading": "第14簽 下下"
    },
    {
      "id": 15,
      "grade": "中平",
      "lines": [
        "兩家門戶各相當",
        "不是姻緣莫較量",
        "直待春風好消息",
        "卻調琴瑟向蘭房"
      ],
      "sourceUrl": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/15",
      "sourceName": "維基文庫《關聖帝君靈籤》",
      "sourceHeading": "第15簽 中平"
    },
    {
      "id": 16,
      "grade": "下下",
      "lines": [
        "官事悠悠難辨明",
        "不如息了且歸耕",
        "傍人煽惑君休信",
        "此事當謀親弟兄"
      ],
      "sourceUrl": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/16",
      "sourceName": "維基文庫《關聖帝君靈籤》",
      "sourceHeading": "第16簽 下下"
    },
    {
      "id": 17,
      "grade": "下下",
      "lines": [
        "田園價貫好商量",
        "事到公庭彼此傷",
        "縱使機關圖得勝",
        "定為後世子孫殃"
      ],
      "sourceUrl": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/17",
      "sourceName": "維基文庫《關聖帝君靈籤》",
      "sourceHeading": "第17簽 下下"
    },
    {
      "id": 18,
      "grade": "中平",
      "lines": [
        "知君指擬是空華",
        "底事茫茫未有涯",
        "牢把腳根踏實地",
        "善為善應永無差"
      ],
      "sourceUrl": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/18",
      "sourceName": "維基文庫《關聖帝君靈籤》",
      "sourceHeading": "第18簽 中平"
    },
    {
      "id": 19,
      "grade": "上吉",
      "lines": [
        "嗟子從來未得時",
        "今年星運頗相宜",
        "營求動作都如意",
        "和合婚姻誕貴兒"
      ],
      "sourceUrl": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/19",
      "sourceName": "維基文庫《關聖帝君靈籤》",
      "sourceHeading": "第19簽 上吉"
    },
    {
      "id": 20,
      "grade": "下下",
      "lines": [
        "一生心事向誰論",
        "十八灘頭說與君",
        "世事盡從流水去",
        "功名富貴等浮雲"
      ],
      "sourceUrl": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/20",
      "sourceName": "維基文庫《關聖帝君靈籤》",
      "sourceHeading": "第20簽 下下"
    },
    {
      "id": 21,
      "grade": "下下",
      "lines": [
        "與君夙昔結成冤",
        "今日相逢那得緣",
        "好把經文多諷誦",
        "祈求戶內保嬋娟"
      ],
      "sourceUrl": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/21",
      "sourceName": "維基文庫《關聖帝君靈籤》",
      "sourceHeading": "第21簽 下下"
    },
    {
      "id": 22,
      "grade": "上吉",
      "lines": [
        "碧玉池中開白蓮",
        "莊嚴色相自天然",
        "生來骨格超凡俗",
        "正是人間第一仙"
      ],
      "sourceUrl": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/22",
      "sourceName": "維基文庫《關聖帝君靈籤》",
      "sourceHeading": "第22簽 上吉"
    },
    {
      "id": 23,
      "grade": "下下",
      "lines": [
        "花開花謝在春風",
        "貴賤窮通百歲中",
        "羨子榮華今已矣",
        "到頭萬事總成空"
      ],
      "sourceUrl": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/23",
      "sourceName": "維基文庫《關聖帝君靈籤》",
      "sourceHeading": "第23簽 下下"
    },
    {
      "id": 24,
      "grade": "中平",
      "lines": [
        "一春萬事苦憂煎",
        "夏裏營求始帖然",
        "更遇秋成冬至後",
        "恰如騎鶴與腰纏"
      ],
      "sourceUrl": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/24",
      "sourceName": "維基文庫《關聖帝君靈籤》",
      "sourceHeading": "第24簽 中平"
    },
    {
      "id": 25,
      "grade": "中平",
      "lines": [
        "寅午戍年多阻滯",
        "亥子丑月漸亨嘉",
        "更逢玉兔金雞會",
        "枯木逢春自放花"
      ],
      "sourceUrl": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/25",
      "sourceName": "維基文庫《關聖帝君靈籤》",
      "sourceHeading": "第25簽 中平"
    },
    {
      "id": 26,
      "grade": "中吉",
      "lines": [
        "年來豐歉皆天數",
        "自是今年旱較多",
        "與子定期三日內",
        "田疇霑足雨滂沱"
      ],
      "sourceUrl": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/26",
      "sourceName": "維基文庫《關聖帝君靈籤》",
      "sourceHeading": "第26簽 中吉"
    },
    {
      "id": 27,
      "grade": "下下",
      "lines": [
        "世間萬物各有主",
        "一粒一毫君莫取",
        "英雄豪傑自天生",
        "也須步步循規矩"
      ],
      "sourceUrl": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/27",
      "sourceName": "維基文庫《關聖帝君靈籤》",
      "sourceHeading": "第27簽 下下"
    },
    {
      "id": 28,
      "grade": "上吉",
      "lines": [
        "公侯將相本無種",
        "好把勤勞契上天",
        "人事盡從天理見",
        "才高豈得困林泉"
      ],
      "sourceUrl": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/28",
      "sourceName": "維基文庫《關聖帝君靈籤》",
      "sourceHeading": "第28簽 上吉"
    },
    {
      "id": 29,
      "grade": "上上",
      "lines": [
        "祖宗積德幾多年",
        "源遠流長慶自然",
        "若更操修無倦已",
        "天須還汝舊青氈"
      ],
      "sourceUrl": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/29",
      "sourceName": "維基文庫《關聖帝君靈籤》",
      "sourceHeading": "第29簽 上上"
    },
    {
      "id": 30,
      "grade": "中吉",
      "lines": [
        "奉公謹守莫欺心",
        "自有亨通吉利臨",
        "目下營求且休矣",
        "秋期與子定佳音"
      ],
      "sourceUrl": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/30",
      "sourceName": "維基文庫《關聖帝君靈籤》",
      "sourceHeading": "第30簽 中吉"
    },
    {
      "id": 31,
      "grade": "中吉",
      "lines": [
        "秋冬作事只尋常",
        "春到門庭漸吉昌",
        "千里信音符遠望",
        "萱堂快樂未渠央"
      ],
      "sourceUrl": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/31",
      "sourceName": "維基文庫《關聖帝君靈籤》",
      "sourceHeading": "第31簽 中吉"
    },
    {
      "id": 32,
      "grade": "下下",
      "lines": [
        "勞心汨汨竟何歸",
        "疾病兼多是與非",
        "事到頭來渾似夢",
        "何如休要用心機"
      ],
      "sourceUrl": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/32",
      "sourceName": "維基文庫《關聖帝君靈籤》",
      "sourceHeading": "第32簽 下下"
    },
    {
      "id": 33,
      "grade": "中平",
      "lines": [
        "不分南北與西東",
        "眼底昏昏耳似聾",
        "熟讀黃庭經一卷",
        "不論貴賤與窮通"
      ],
      "sourceUrl": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/33",
      "sourceName": "維基文庫《關聖帝君靈籤》",
      "sourceHeading": "第33簽 中平"
    },
    {
      "id": 34,
      "grade": "中平",
      "lines": [
        "春夏纔過秋又冬",
        "紛紛謀慮攪心胸",
        "貴人垂手來相援",
        "休把私心情意濃"
      ],
      "sourceUrl": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/34",
      "sourceName": "維基文庫《關聖帝君靈籤》",
      "sourceHeading": "第34簽 中平"
    },
    {
      "id": 35,
      "grade": "下下",
      "lines": [
        "一山如畫對清江",
        "門裏團圓事事雙",
        "誰料半途分折去",
        "空幃無語對銀缸"
      ],
      "sourceUrl": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/35",
      "sourceName": "維基文庫《關聖帝君靈籤》",
      "sourceHeading": "第35簽 下下"
    },
    {
      "id": 36,
      "grade": "上吉",
      "lines": [
        "功名富貴自能為",
        "偶著仙鞭莫問伊",
        "萬里鵬程君有分",
        "吳山頂上好鑽龜"
      ],
      "sourceUrl": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/36",
      "sourceName": "維基文庫《關聖帝君靈籤》",
      "sourceHeading": "第36簽 上吉"
    },
    {
      "id": 37,
      "grade": "中平",
      "lines": [
        "焚香來告復何辭",
        "善惡平分汝自知",
        "屏卻昧公心裏事",
        "出門無礙是通時"
      ],
      "sourceUrl": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/37",
      "sourceName": "維基文庫《關聖帝君靈籤》",
      "sourceHeading": "第37簽 中平"
    },
    {
      "id": 38,
      "grade": "下下",
      "lines": [
        "蛩吟唧唧守孤幃",
        "千里懸懸望信歸",
        "等得榮華公子到",
        "秋冬括括雨靡靡"
      ],
      "sourceUrl": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/38",
      "sourceName": "維基文庫《關聖帝君靈籤》",
      "sourceHeading": "第38簽 下下"
    },
    {
      "id": 39,
      "grade": "下下",
      "lines": [
        "北山門下好安居",
        "若問終時慎厥初",
        "堪笑包藏許多事",
        "鱗鴻雖便莫修書"
      ],
      "sourceUrl": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/39",
      "sourceName": "維基文庫《關聖帝君靈籤》",
      "sourceHeading": "第39簽 下下"
    },
    {
      "id": 40,
      "grade": "上吉",
      "lines": [
        "新來換得好規模",
        "何用隨他步與趨",
        "只聽耳邊消息到",
        "崎嶇歷盡見亨衢"
      ],
      "sourceUrl": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/40",
      "sourceName": "維基文庫《關聖帝君靈籤》",
      "sourceHeading": "第40簽 上吉"
    },
    {
      "id": 41,
      "grade": "中吉",
      "lines": [
        "自南自北自東西",
        "欲到天涯誰作梯",
        "遇鼠逢牛三弄笛",
        "好將名姓榜頭題"
      ],
      "sourceUrl": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/41",
      "sourceName": "維基文庫《關聖帝君靈籤》",
      "sourceHeading": "第41簽 中吉"
    },
    {
      "id": 42,
      "grade": "中吉",
      "lines": [
        "我曾許汝事和諧",
        "誰料修為汝自乖",
        "但改新圖莫依舊",
        "營謀應得稱心懷"
      ],
      "sourceUrl": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/42",
      "sourceName": "維基文庫《關聖帝君靈籤》",
      "sourceHeading": "第42簽 中吉"
    },
    {
      "id": 43,
      "grade": "中吉",
      "lines": [
        "一紙官書火急催",
        "扁舟速下浪如雷",
        "雖然目下多驚險",
        "保汝平安去復回"
      ],
      "sourceUrl": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/43",
      "sourceName": "維基文庫《關聖帝君靈籤》",
      "sourceHeading": "第43簽 中吉"
    },
    {
      "id": 44,
      "grade": "中平",
      "lines": [
        "汝是人中最吉人",
        "誤為誤作損精神",
        "堅牢一念酬香願",
        "富貴榮華萃汝身"
      ],
      "sourceUrl": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/44",
      "sourceName": "維基文庫《關聖帝君靈籤》",
      "sourceHeading": "第44簽 中平"
    },
    {
      "id": 45,
      "grade": "中平",
      "lines": [
        "好將心地力耕耘",
        "彼此山頭總是墳",
        "陰地不如心地好",
        "修為到底卻輸君"
      ],
      "sourceUrl": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/45",
      "sourceName": "維基文庫《關聖帝君靈籤》",
      "sourceHeading": "第45簽 中平"
    },
    {
      "id": 46,
      "grade": "中平",
      "lines": [
        "君是山中萬戶侯",
        "信知騎馬勝騎牛",
        "今朝馬上看山色",
        "爭似騎牛得自由"
      ],
      "sourceUrl": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/46",
      "sourceName": "維基文庫《關聖帝君靈籤》",
      "sourceHeading": "第46簽 中平"
    },
    {
      "id": 47,
      "grade": "下下",
      "lines": [
        "與君萬語復千言",
        "祗欲平和雪爾冤",
        "訟則終凶君記取",
        "試於清夜把心捫"
      ],
      "sourceUrl": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/47",
      "sourceName": "維基文庫《關聖帝君靈籤》",
      "sourceHeading": "第47簽 下下"
    },
    {
      "id": 48,
      "grade": "中平",
      "lines": [
        "登山涉水正天寒",
        "兄弟姻親那得安",
        "幸遇虎頭人一喚",
        "全家遂保汝重歡"
      ],
      "sourceUrl": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/48",
      "sourceName": "維基文庫《關聖帝君靈籤》",
      "sourceHeading": "第48簽 中平"
    },
    {
      "id": 49,
      "grade": "下下",
      "lines": [
        "彼此家居只一山",
        "如何似隔鬼門關",
        "日月如梭人易老",
        "許多勞碌不如閒"
      ],
      "sourceUrl": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/49",
      "sourceName": "維基文庫《關聖帝君靈籤》",
      "sourceHeading": "第49簽 下下"
    },
    {
      "id": 50,
      "grade": "上平",
      "lines": [
        "人說今年勝舊年",
        "也須步多要周旋",
        "一家和氣多生福",
        "萋菲讒言莫聽偏"
      ],
      "sourceUrl": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/50",
      "sourceName": "維基文庫《關聖帝君靈籤》",
      "sourceHeading": "第50簽 上平"
    },
    {
      "id": 51,
      "grade": "上吉",
      "lines": [
        "君今百事且隨緣",
        "水到渠成聽自然",
        "莫嘆年來不如意",
        "喜逢新運稱心田"
      ],
      "sourceUrl": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/51",
      "sourceName": "維基文庫《關聖帝君靈籤》",
      "sourceHeading": "第51簽 上吉"
    },
    {
      "id": 52,
      "grade": "上吉",
      "lines": [
        "兀坐幽居歎寂寥",
        "孤燈掩映度清宵",
        "萬金忽報秋光好",
        "活計扁舟渡北朝"
      ],
      "sourceUrl": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/52",
      "sourceName": "維基文庫《關聖帝君靈籤》",
      "sourceHeading": "第52簽 上吉"
    },
    {
      "id": 53,
      "grade": "下下",
      "lines": [
        "艱難險阻路蹊蹺",
        "南鳥孤飛依北巢",
        "今日貴人曾識面",
        "相逢卻在夏秋交"
      ],
      "sourceUrl": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/53",
      "sourceName": "維基文庫《關聖帝君靈籤》",
      "sourceHeading": "第53簽 下下"
    },
    {
      "id": 54,
      "grade": "中平",
      "lines": [
        "萬人叢裏逞英豪",
        "便欲飛騰霄漢高",
        "爭奈承流風未便",
        "青燈黃卷且勤勞"
      ],
      "sourceUrl": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/54",
      "sourceName": "維基文庫《關聖帝君靈籤》",
      "sourceHeading": "第54簽 中平"
    },
    {
      "id": 55,
      "grade": "中平",
      "lines": [
        "勤耕力作莫蹉跎",
        "衣食隨時安分過",
        "縱使經商收倍利",
        "不如逐歲廩禾多"
      ],
      "sourceUrl": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/55",
      "sourceName": "維基文庫《關聖帝君靈籤》",
      "sourceHeading": "第55簽 中平"
    },
    {
      "id": 56,
      "grade": "下下",
      "lines": [
        "心頭理曲強詞遮",
        "直欲欺官行路斜",
        "一旦醜形臨月鏡",
        "身投憲網莫咨嗟"
      ],
      "sourceUrl": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/56",
      "sourceName": "維基文庫《關聖帝君靈籤》",
      "sourceHeading": "第56簽 下下"
    },
    {
      "id": 57,
      "grade": "中平",
      "lines": [
        "事端百出慮雖長",
        "莫聽人言自主張",
        "一著仙機君記取",
        "紛紛鬧裏更思量"
      ],
      "sourceUrl": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/57",
      "sourceName": "維基文庫《關聖帝君靈籤》",
      "sourceHeading": "第57簽 中平"
    },
    {
      "id": 58,
      "grade": "上吉",
      "lines": [
        "蘇秦三寸足平生",
        "富貴功名在此行",
        "更好修為陰騭事",
        "前程萬里自通亨"
      ],
      "sourceUrl": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/58",
      "sourceName": "維基文庫《關聖帝君靈籤》",
      "sourceHeading": "第58簽 上吉"
    },
    {
      "id": 59,
      "grade": "中平",
      "lines": [
        "門衰戶冷苦伶仃",
        "自嘆祈求不一靈",
        "幸有祖宗陰騭在",
        "香煙未斷續螟蛉"
      ],
      "sourceUrl": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/59",
      "sourceName": "維基文庫《關聖帝君靈籤》",
      "sourceHeading": "第59簽 中平"
    },
    {
      "id": 60,
      "grade": "上上",
      "lines": [
        "羨君兄弟好名聲",
        "只管謙撝莫自矜",
        "丹詔槐黃相逼近",
        "巍巍科甲兩同登"
      ],
      "sourceUrl": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/60",
      "sourceName": "維基文庫《關聖帝君靈籤》",
      "sourceHeading": "第60簽 上上"
    },
    {
      "id": 61,
      "grade": "中平",
      "lines": [
        "嘯聚山林兇惡儔",
        "善良無事苦煎憂",
        "主人大笑出門去",
        "不用干戈盜賊休"
      ],
      "sourceUrl": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/61",
      "sourceName": "維基文庫《關聖帝君靈籤》",
      "sourceHeading": "第61簽 中平"
    },
    {
      "id": 62,
      "grade": "中平",
      "lines": [
        "百千人面虎狼心",
        "賴汝干戈用力深",
        "得勝回時秋漸老",
        "虎頭城裏喜相尋"
      ],
      "sourceUrl": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/62",
      "sourceName": "維基文庫《關聖帝君靈籤》",
      "sourceHeading": "第62簽 中平"
    },
    {
      "id": 63,
      "grade": "中平",
      "lines": [
        "曩時敗北且圖南",
        "筋力雖衰尚一堪",
        "欲識生前君大數",
        "前三三與後三三"
      ],
      "sourceUrl": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/63",
      "sourceName": "維基文庫《關聖帝君靈籤》",
      "sourceHeading": "第63簽 中平"
    },
    {
      "id": 64,
      "grade": "上上",
      "lines": [
        "吉人相遇本和同",
        "況有持謀天水翁",
        "人力不勞公論協",
        "事成功倍笑談中"
      ],
      "sourceUrl": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/64",
      "sourceName": "維基文庫《關聖帝君靈籤》",
      "sourceHeading": "第64簽 上上"
    },
    {
      "id": 65,
      "grade": "上上",
      "lines": [
        "朔風凜凜正窮冬",
        "多羨門庭喜氣濃",
        "更入新春人事後",
        "衷言方得信先容"
      ],
      "sourceUrl": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/65",
      "sourceName": "維基文庫《關聖帝君靈籤》",
      "sourceHeading": "第65簽 上上"
    },
    {
      "id": 66,
      "grade": "上上",
      "lines": [
        "耕耘只可在鄉邦",
        "何用求謀向外方",
        "見說今年新運好",
        "門闌喜氣事雙雙"
      ],
      "sourceUrl": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/66",
      "sourceName": "維基文庫《關聖帝君靈籤》",
      "sourceHeading": "第66簽 上上"
    },
    {
      "id": 67,
      "grade": "中平",
      "lines": [
        "纔發君心天已知",
        "何須問我決狐疑",
        "願子改圖從孝悌",
        "不愁家室不相宜"
      ],
      "sourceUrl": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/67",
      "sourceName": "維基文庫《關聖帝君靈籤》",
      "sourceHeading": "第67簽 中平"
    },
    {
      "id": 68,
      "grade": "中平",
      "lines": [
        "南販珍珠北販鹽",
        "年來幾倍貨財添",
        "勸君止此求田舍",
        "心欲多時何日厭"
      ],
      "sourceUrl": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/68",
      "sourceName": "維基文庫《關聖帝君靈籤》",
      "sourceHeading": "第68簽 中平"
    },
    {
      "id": 69,
      "grade": "下下",
      "lines": [
        "捨舟遵路總相宜",
        "慎勿嬉遊逐貴兒",
        "一夜樽前兄與弟",
        "明朝仇敵又相隨"
      ],
      "sourceUrl": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/69",
      "sourceName": "維基文庫《關聖帝君靈籤》",
      "sourceHeading": "第69簽 下下"
    },
    {
      "id": 70,
      "grade": "中平",
      "lines": [
        "雷雨風雲各有司",
        "至誠禱告莫生疑",
        "與君定約為霖日",
        "正是蘊隆中伏時"
      ],
      "sourceUrl": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/70",
      "sourceName": "維基文庫《關聖帝君靈籤》",
      "sourceHeading": "第70簽 中平"
    },
    {
      "id": 71,
      "grade": "中平",
      "lines": [
        "喜鵲簷前報好音",
        "知君千里欲歸心",
        "繡幃重結鴛鴦帶",
        "葉落霜飛寒色侵"
      ],
      "sourceUrl": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/71",
      "sourceName": "維基文庫《關聖帝君靈籤》",
      "sourceHeading": "第71簽 中平"
    },
    {
      "id": 72,
      "grade": "下下",
      "lines": [
        "河渠傍路有高低",
        "可歎長途日已西",
        "縱有榮華好時節",
        "直須猴犬換金雞"
      ],
      "sourceUrl": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/72",
      "sourceName": "維基文庫《關聖帝君靈籤》",
      "sourceHeading": "第72簽 下下"
    },
    {
      "id": 73,
      "grade": "下下",
      "lines": [
        "憶昔蘭房分半釵",
        "而今忽把信音乖",
        "痴心指望成連理",
        "到底誰知事不諧"
      ],
      "sourceUrl": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/73",
      "sourceName": "維基文庫《關聖帝君靈籤》",
      "sourceHeading": "第73簽 下下"
    },
    {
      "id": 74,
      "grade": "上吉",
      "lines": [
        "崔巍崔魏復崔巍",
        "履險如夷去復來",
        "身似菩提心似鏡",
        "長安一道放春回"
      ],
      "sourceUrl": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/74",
      "sourceName": "維基文庫《關聖帝君靈籤》",
      "sourceHeading": "第74簽 上吉"
    },
    {
      "id": 75,
      "grade": "中吉",
      "lines": [
        "生前結得好緣姻",
        "一笑相逢情自親",
        "相當人物無高下",
        "得意休論富與貧"
      ],
      "sourceUrl": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/75",
      "sourceName": "維基文庫《關聖帝君靈籤》",
      "sourceHeading": "第75簽 中吉"
    },
    {
      "id": 76,
      "grade": "中平",
      "lines": [
        "三千法律八千文",
        "此事何如說與君",
        "善惡兩途君自作",
        "一生禍福此中分"
      ],
      "sourceUrl": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/76",
      "sourceName": "維基文庫《關聖帝君靈籤》",
      "sourceHeading": "第76簽 中平"
    },
    {
      "id": 77,
      "grade": "下下",
      "lines": [
        "木有根荄水有源",
        "君當自此究其原",
        "莫隨道路人閒話",
        "訟到終凶是至言"
      ],
      "sourceUrl": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/77",
      "sourceName": "維基文庫《關聖帝君靈籤》",
      "sourceHeading": "第77簽 下下"
    },
    {
      "id": 78,
      "grade": "下下",
      "lines": [
        "家道豊腴自飽溫",
        "也須肚裏立乾坤",
        "財多害己君當省",
        "福有胚胎禍有門"
      ],
      "sourceUrl": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/78",
      "sourceName": "維基文庫《關聖帝君靈籤》",
      "sourceHeading": "第78簽 下下"
    },
    {
      "id": 79,
      "grade": "中平",
      "lines": [
        "乾亥來龍仔細看",
        "坎居午向自當安",
        "若移丑艮陰陽逆",
        "門戶凋零家道難"
      ],
      "sourceUrl": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/79",
      "sourceName": "維基文庫《關聖帝君靈籤》",
      "sourceHeading": "第79簽 中平"
    },
    {
      "id": 80,
      "grade": "中平",
      "lines": [
        "一朝無事忽遭官",
        "也是門衰墳未安",
        "改換陰陽移禍福",
        "勸君莫作等閒看"
      ],
      "sourceUrl": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/80",
      "sourceName": "維基文庫《關聖帝君靈籤》",
      "sourceHeading": "第80簽 中平"
    },
    {
      "id": 81,
      "grade": "中平",
      "lines": [
        "假君財物自當還",
        "謀賴心欺他自奸",
        "幸有高臺明月鏡",
        "請來對照破機關"
      ],
      "sourceUrl": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/81",
      "sourceName": "維基文庫《關聖帝君靈籤》",
      "sourceHeading": "第81簽 中平"
    },
    {
      "id": 82,
      "grade": "上吉",
      "lines": [
        "彼亦儔中一輩賢",
        "勸君特達與周旋",
        "此時賓主歡相會",
        "他日王侯卻並肩"
      ],
      "sourceUrl": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/82",
      "sourceName": "維基文庫《關聖帝君靈籤》",
      "sourceHeading": "第82簽 上吉"
    },
    {
      "id": 83,
      "grade": "下下",
      "lines": [
        "隨分堂前赴粥饘",
        "何須妄想苦憂煎",
        "主張門戶誠難事",
        "百歲安閒得幾年"
      ],
      "sourceUrl": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/83",
      "sourceName": "維基文庫《關聖帝君靈籤》",
      "sourceHeading": "第83簽 下下"
    },
    {
      "id": 84,
      "grade": "中平",
      "lines": [
        "箇中事緒更紛然",
        "當局須知一著先",
        "長舌婦人休酷聽",
        "力行禮義要心堅"
      ],
      "sourceUrl": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/84",
      "sourceName": "維基文庫《關聖帝君靈籤》",
      "sourceHeading": "第84簽 中平"
    },
    {
      "id": 85,
      "grade": "中平",
      "lines": [
        "一春風雨正瀟瀟",
        "千里行人去路遙",
        "移寡就多君得計",
        "如何歸路轉無聊"
      ],
      "sourceUrl": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/85",
      "sourceName": "維基文庫《關聖帝君靈籤》",
      "sourceHeading": "第85簽 中平"
    },
    {
      "id": 86,
      "grade": "上上",
      "lines": [
        "一舟行貨好招邀",
        "積少成多自富饒",
        "常把他人比自己",
        "管須日後勝今朝"
      ],
      "sourceUrl": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/86",
      "sourceName": "維基文庫《關聖帝君靈籤》",
      "sourceHeading": "第86簽 上上"
    },
    {
      "id": 87,
      "grade": "下下",
      "lines": [
        "陰裏詳看怪爾曹",
        "舟中敵圖笑中刀",
        "藩籬剖破渾無事",
        "一種天生惜羽毛"
      ],
      "sourceUrl": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/87",
      "sourceName": "維基文庫《關聖帝君靈籤》",
      "sourceHeading": "第87簽 下下"
    },
    {
      "id": 88,
      "grade": "上吉",
      "lines": [
        "從前作事總徒勞",
        "纔見新春時漸遭",
        "百計營求都得意",
        "更須守己莫心高"
      ],
      "sourceUrl": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/88",
      "sourceName": "維基文庫《關聖帝君靈籤》",
      "sourceHeading": "第88簽 上吉"
    },
    {
      "id": 89,
      "grade": "中平",
      "lines": [
        "樽前無事且高歌",
        "時未來時奈若何",
        "白馬渡江嘶日暮",
        "虎頭城裏看巍峨"
      ],
      "sourceUrl": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/89",
      "sourceName": "維基文庫《關聖帝君靈籤》",
      "sourceHeading": "第89簽 中平"
    },
    {
      "id": 90,
      "grade": "中平",
      "lines": [
        "崆峒城裏事如麻",
        "無事如君有幾家",
        "勸汝不須勤致禱",
        "徒勞生事苦咨嘆"
      ],
      "sourceUrl": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/90",
      "sourceName": "維基文庫《關聖帝君靈籤》",
      "sourceHeading": "第90簽 中平"
    },
    {
      "id": 91,
      "grade": "中平",
      "lines": [
        "佛說淘沙始見金",
        "只緣君子不勞心",
        "榮華總得詩書效",
        "妙裏工夫仔細尋"
      ],
      "sourceUrl": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/91",
      "sourceName": "維基文庫《關聖帝君靈籤》",
      "sourceHeading": "第91簽 中平"
    },
    {
      "id": 92,
      "grade": "下下",
      "lines": [
        "今年禾穀不如前",
        "物價喧騰倍百年",
        "災數流行多疫癘",
        "一陽復後始安全"
      ],
      "sourceUrl": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/92",
      "sourceName": "維基文庫《關聖帝君靈籤》",
      "sourceHeading": "第92簽 下下"
    },
    {
      "id": 93,
      "grade": "中平",
      "lines": [
        "春來雨水太連綿",
        "入夏晴乾雨又愆",
        "節氣直交三伏始",
        "喜逢滂沛足田園"
      ],
      "sourceUrl": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/93",
      "sourceName": "維基文庫《關聖帝君靈籤》",
      "sourceHeading": "第93簽 中平"
    },
    {
      "id": 94,
      "grade": "中平",
      "lines": [
        "一般器用與人同",
        "巧斲輪輿梓匠工",
        "凡事有緣且隨分",
        "秋冬方遇主人翁"
      ],
      "sourceUrl": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/94",
      "sourceName": "維基文庫《關聖帝君靈籤》",
      "sourceHeading": "第94簽 中平"
    },
    {
      "id": 95,
      "grade": "中平",
      "lines": [
        "知君袖內有驪珠",
        "生不逢辰亦強圖",
        "可歎頭顱已如許",
        "而今方得貴人扶"
      ],
      "sourceUrl": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/95",
      "sourceName": "維基文庫《關聖帝君靈籤》",
      "sourceHeading": "第95簽 中平"
    },
    {
      "id": 96,
      "grade": "上吉",
      "lines": [
        "婚姻子息莫嫌遲",
        "但把精神仗佛持",
        "四十年前須報應",
        "功圓行滿育馨兒"
      ],
      "sourceUrl": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/96",
      "sourceName": "維基文庫《關聖帝君靈籤》",
      "sourceHeading": "第96簽 上吉"
    },
    {
      "id": 97,
      "grade": "上上",
      "lines": [
        "五十功名心已灰",
        "那知富貴逼人來",
        "更行好事存方寸",
        "壽比岡陵位鼎台"
      ],
      "sourceUrl": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/97",
      "sourceName": "維基文庫《關聖帝君靈籤》",
      "sourceHeading": "第97簽 上上"
    },
    {
      "id": 98,
      "grade": "中平",
      "lines": [
        "經營百出費精神",
        "南北奔馳運未新",
        "玉兔交時當得意",
        "恰如枯木再逢春"
      ],
      "sourceUrl": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/98",
      "sourceName": "維基文庫《關聖帝君靈籤》",
      "sourceHeading": "第98簽 中平"
    },
    {
      "id": 99,
      "grade": "上上",
      "lines": [
        "貴人遭遇水雲鄉",
        "冷淡交情滋味長",
        "黃閣開時延故客",
        "驊騮應得驟康莊"
      ],
      "sourceUrl": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/99",
      "sourceName": "維基文庫《關聖帝君靈籤》",
      "sourceHeading": "第99簽 上上"
    },
    {
      "id": 100,
      "grade": "上上",
      "lines": [
        "我本天仙雷雨師",
        "吉凶禍福我先知",
        "至誠禱祝皆靈應",
        "抽得終籤百事宜"
      ],
      "sourceUrl": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/100",
      "sourceName": "維基文庫《關聖帝君靈籤》",
      "sourceHeading": "第100簽 上上"
    }
  ]
}